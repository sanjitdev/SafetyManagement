{
  "name": "cityfix",
  "version": "0.1.0",
  "private": true,
  "description": "CityFix — citizen-powered city issue reporting and tracking platform. Design artifacts live under design-artifacts/. Playwright is installed for mockup-vs-build visual comparison.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:feat": "cross-env CITYFIX_DEV_STORE=1 next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "test:mockups": "playwright test tests/01-mockups.spec.ts",
    "test:update-baselines": "playwright test tests/01-mockups.spec.ts --update-snapshots",
    "test:report": "playwright show-report",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/browser": "^10.0.0",
    "@simplewebauthn/server": "^10.0.0",
    "fs-extra": "^11.4.1",
    "js-yaml": "^5.4.3",
    "maplibre-gl": "^4.7.1",
    "next": "^14.2.18",
    "otpauth": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "twilio": "^4.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.5"
  }
}
