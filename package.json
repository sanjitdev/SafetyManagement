{
  "name": "cityfix",
  "version": "0.1.0",
  "private": true,
  "description": "CityFix — citizen-powered city issue reporting and tracking platform. Design artifacts live under design-artifacts/. Playwright is installed for mockup-vs-build visual comparison.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:feat": "cross-env CITYFIX_DEV_STORE=1 next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:mockups": "playwright test tests/01-mockups.spec.ts",
    "test:update-baselines": "playwright test tests/01-mockups.spec.ts --update-snapshots",
    "test:report": "playwright show-report",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/browser": "^10.0.0",
    "@simplewebauthn/server": "^10.0.0",
    "maplibre-gl": "^4.7.1",
    "next": "^14.2.18",
    "otpauth": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "twilio": "^4.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.5"
  }
}
