.next/
out/
next-env.d.ts.bak
# TypeScript incremental build cache (regenerated by tsc --noEmit / next build)
tsconfig.tsbuildinfo

# Local environment files (kept out of the repo for civic-platform security posture)
.env
.env.local
.env.*.local

