# Node / Playwright
node_modules/
test-results/
playwright/.cache/

# Generated test reports (regenerated locally; never committed)
coverage/
playwright-report/

# UI audit output (regenerated on every `ui-audit.mjs` / `flow-walk.mjs`
# run; ~25MB of PNGs). The Playwright BASELINES under
# tests-mockups/baselines/ ARE committed — they are regression gates.
# These are not: they are a record of one audit pass.
ui-audit-shots/

# Local curl cookie jars used by the manual smoke-test loop.
# These carry live `cityfix_session` cookies — never commit them.
cf-cookies.txt

# Generated Playwright test outputs (baselines live in tests-mockups/baselines/ and ARE committed)
tests-mockups/artifacts/
tests-mockups/artifacts/**
tests-mockups/html-report/
# Diff images copied out of the container by the two-baseline diagnostic
# (scripts/run-two-baseline-diag.sh) — a debugging aid, not a deliverable.
tests-mockups/diffs/

# Per-run UI audit captures. Each spec (02-live-audit, 03-authenticated-flow,
# 04-e2e-human-tester, …) writes its screenshots here on every run, so the
# tree churns on each suite execution. These are a record of ONE audit pass,
# not regression gates — the gates are the `toHaveScreenshot` baselines under
# tests-mockups/baselines/. The spec headers say as much ("Screenshots from
# this spec are NOT committed baselines and are gitignored"); this rule is
# what makes that true.
tests-mockups/audit/

# Local visual-check renders from `node scripts/render-mockups.mjs`. These
# are a developer's eyeball pass on Windows; the committed baselines under
# tests-mockups/baselines/ are produced by CI on ubuntu-latest and are the
# only regression gate.
tests-mockups/scratch-render/

