# Node / Playwright
node_modules/
test-results/
playwright/.cache/

# Generated test reports (regenerated locally; never committed)
coverage/
playwright-report/

# UI audit output (regenerated on every `ui-audit.mjs` / `flow-walk.mjs`
# run; ~25MB of PNGs). The Playwright BASELINES under
# tests-mockups/baselines/ ARE committed — they are regression gates.
# These are not: they are a record of one audit pass.
ui-audit-shots/

# Local curl cookie jars used by the manual smoke-test loop.
# These carry live `cityfix_session` cookies — never commit them.
cf-cookies.txt

# Generated Playwright test outputs (baselines live in tests-mockups/baselines/ and ARE committed)
tests-mockups/artifacts/
tests-mockups/artifacts/**
tests-mockups/html-report/
# Diff images copied out of the container by the two-baseline diagnostic
# (scripts/run-two-baseline-diag.sh) — a debugging aid, not a deliverable.
tests-mockups/diffs/

# Per-run UI audit captures. Each spec (02-live-audit, 03-authenticated-flow,
# 04-e2e-human-tester, …) writes its screenshots here on every run, so the
# tree churns on each suite execution. These are a record of ONE audit pass,
# not regression gates — the gates are the `toHaveScreenshot` baselines under
# tests-mockups/baselines/. The spec headers say as much ("Screenshots from
# this spec are NOT committed baselines and are gitignored"); this rule is
# what makes that true.
tests-mockups/audit/

# Next.js build output
.next/
out/
next-env.d.ts.bak
# TypeScript incremental build cache (regenerated by tsc --noEmit / next build)
tsconfig.tsbuildinfo

# Local environment files (kept out of the repo for civic-platform security posture)
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
*.log

# WDS module internals — should never be touched by anything but the WDS sync tool
.wds/.cache/

# Next.js auto-generated TypeScript shim (regenerated on every build)
next-env.d.ts

# Per-developer MCP server config (consumes env-var secrets; not for the shared repo)
.mcp.json

# Per-developer AI agent tooling installations (not project code)
# Per AGENTS.md, the WDS standalone install lives outside the repo; these
# four trees are local CLI/framework state for the AI-DLC + WDS + BMad stack
# and would be reinstalled per-developer via their respective installers.
#
# Note on .specsmd/: the canonical specsmd memory bank
# (.specsmd/aidlc/memory-bank/** and .specsmd/memory-bank/**) IS
# committed to main as the team's durable brief artefact (intent
# briefs, unit briefs, bolt records, story index, decision log,
# standards). Only the per-developer runtime cache (agents, scripts,
# skills, templates) stays gitignored, as a re-pull of the specsmd
# framework replaces those locally without touching the briefs.
.puku-cli/
_bmad/
.wds/

# specsmd runtime cache (per-developer; re-installed by the specsmd
# framework). The memory bank (intents/bolts/standards/story-index.md
# /project.yaml/maintenance-log.md) is the team's durable record and
# is the default-untracked state under .specsmd/. We do NOT use a
# broad `.specsmd/` ignore here because that pattern blocks `git add`
# from materializing the memory bank (git's add path is more
# conservative than check-ignore). Instead, the runtime-cache
# subtrees below are explicitly excluded, and the framework's own
# distributable files (README, manifest, quick-start, context-config,
# memory-bank.yaml) are excluded by name. Everything else under
# .specsmd/ is implicitly committed.
.specsmd/aidlc/agents/
.specsmd/aidlc/scripts/
.specsmd/aidlc/skills/
.specsmd/aidlc/templates/
.specsmd/aidlc/README.md
.specsmd/aidlc/manifest.yaml
.specsmd/aidlc/context-config.yaml
.specsmd/aidlc/memory-bank.yaml
.specsmd/aidlc/quick-start.md

# BEGIN AI-DLC:gitignore
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI-DLC — the committed-vs-ignored split (workspace layout, re-rooted under aidlc/).
# Rule of thumb (vision §5.1): per-user session CURSORS and machine-local
# runtime/derived state are ignored; everything that is the shared work —
# method, registry, state, AUDIT (per-clone shards), artifacts — is committed.
#
# Per-user session cursors — ignored (two teammates legitimately point at
# different spaces/intents at once; committing them would turn per-user
# navigation into shared state and cause conflicts on intent creation and cursor switches).
aidlc/active-space
aidlc/spaces/*/intents/active-intent
#
# Machine-local runtime / derived — ignored (regenerated per machine).
# The clone-id token names this clone's audit shard; it MUST stay machine-local
# (gitignored) or every clone from a commit would share a shard and git-conflict.
aidlc/.aidlc-clone-id
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
# Atomic active-space create staging (normally unlinked immediately).
aidlc/.aidlc-active-space-*.tmp
# Per-conversation session→intent map (resume rebind, P8): per-user runtime
# state keyed by Claude Code session_id, never shared truth.
aidlc/.aidlc-sessions/
aidlc/spaces/*/intents/.aidlc-*
# Framework state at any depth, including the bare space intents root and
# package-local record trees; keep unrelated application dot folders visible.
**/aidlc/spaces/*/intents/**/.aidlc-engine/
**/aidlc/spaces/*/intents/**/.aidlc-sensors/
# DocumentKB staged-transaction scratch: `onboard` stages a document into
# `.journal/<txn-id>/` and renames it into place under the audit lock. Per-clone
# and transient -- a committed journal would be a merge conflict on every
# concurrent sync, and a crashed run's leftovers would be committed as if they
# were work. Collected on the next sync; named by txn id, referenced by no index
# row, so removal is always safe.
aidlc/spaces/*/knowledge/documentkb/.journal/
# DocumentKB `linked`-source alias map: alias -> a machine-specific ABSOLUTE
# root. Committing it would give every clone one developer's directory layout,
# which is the exact failure the "never an absolute path in committed metadata"
# rule exists to prevent. The committed side holds only the alias.
aidlc/spaces/*/knowledge/.sources.local.json
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
# Redacted diagnostic reports (/aidlc --doctor --export): regenerated, meant to
# be shared then deleted — machine-local derived output, never shared truth.
aidlc/diagnostics/
#
# COMMITTED (NOT ignored, listed here for the record — do NOT add ignore rules
# for these): aidlc/spaces/*/memory/** · aidlc/spaces/*/codekb/** ·
# aidlc/spaces/*/intents/intents.json · aidlc/spaces/*/intents/*/aidlc-state.md ·
# aidlc/spaces/*/intents/*/audit/*.md (the audit trail, committed as PER-CLONE
# SHARDS: each machine appends to audit/<host>-<clone>.md so git never merges
# concurrent appends — there is intentionally NO .gitattributes merge=union,
# which was proven to corrupt the multi-line audit blocks) ·
# aidlc/spaces/*/intents/*/<phase>/<stage>/*.md (artifacts + diary).
.claude/settings.local.json
# END AI-DLC:gitignore

.vercel
.env*
