# CityFix environment template — copy to .env.local for local dev.
# Real secrets NEVER go in version control (per .gitignore).
#
# Environment scope:
#   [DEV-ONLY]   only used by the local dev store (CITYFIX_DEV_STORE=1);
#                can be unset in prod.
#   [PROD-REQ]   must be set in prod (Vercel) for the app to start.
#   [OPTIONAL]   has a safe default; set only if you want to override.

# --- Database (PLAT-REQ-001; tech-audit §5: PostgreSQL 16 + Prisma) ---
# [PROD-REQ] Use a hosted Postgres in prod (Neon, Supabase, Railway).
#
# DATABASE SPLIT — local and production point at DIFFERENT databases:
#   local  → a PostgreSQL server on the dev machine (localhost:5432)
#   prod   → Neon (hosted)
#
# `.env.local` is the LOCAL config; production's DATABASE_URL lives in the
# Vercel project environment, so this file can never affect a deployment.
# `lib/platform/db-guard.ts` additionally refuses to start production
# against a loopback host, so a local URL cannot reach production by
# accident.
#
# To set up the local database from scratch:
#   npm run db:setup      # migrate + seed (reads .env.local)
#   npm run db:studio     # browse it in Prisma Studio
DATABASE_URL="postgresql://cityfix:cityfix@localhost:5432/cityfix?schema=public"

# --- Session cookie signing key (PLAT-REQ-002) ---
# [PROD-REQ] Generate with: openssl rand -hex 32
#            Must be at least 32 characters; lib/auth/session.ts throws otherwise.
SESSION_SECRET="dev-session-secret-change-me-in-production-min-32-bytes"

# --- WebAuthn (PLAT-REQ-002 admin writes) ---
# [PROD-REQ] RP_ID = the prod hostname (no scheme, no port).
#            RP_ORIGIN = the full origin (https://...).
#            lib/auth/webauthn.ts throws on prod start if these are
#            unset or non-https.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_ORIGIN="http://localhost:3000"
WEBAUTHN_RP_NAME="CityFix"

# --- Web Push (PLAT-REQ-006; tech-audit §3) ---
# [OPTIONAL] v1 ships with push notifications stubbed; the wire
# call is v1.1. Set these to enable push in the meantime.
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:dev@cityfix.local"

# --- OTP SMS provider (PLAT-REQ-002; Bolt 005-003) ---
# [OPTIONAL] Default 'stub' (dev only — logs the code to console).
#            In prod, set to 'twilio' for real SMS delivery; then
#            the three TWILIO_* vars below are required.
OTP_PROVIDER="stub"

# Twilio (only when OTP_PROVIDER=twilio). Generate at https://console.twilio.com/
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# E.164-formatted from-number, e.g. +15555550100
TWILIO_FROM_NUMBER=""

# --- Dev store (DEV-ONLY) ---
# [DEV-ONLY] Set to "1" to use the in-memory dev store instead of
# Prisma. The dev store lets you sign in as a seeded persona via
# /api/dev/login without an OTP/WebAuthn ceremony. NEVER set in
# prod — the dev routes return 404 when this is unset.
CITYFIX_DEV_STORE=""

# --- Rate limiting (PLAT-REQ-008) ---
# [OPTIONAL] Default 1 req/sec.
POLL_RATE_LIMIT_PER_SECOND=1