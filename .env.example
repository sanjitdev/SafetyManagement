# CityFix environment template — copy to .env.local for local dev.
# Real secrets NEVER go in version control (per .gitignore).

# --- Database (PLAT-REQ-001; tech-audit §5: PostgreSQL 16 + Prisma) ---
# Local dev defaults to docker-compose or a local Postgres. CI uses ephemeral.
DATABASE_URL="postgresql://cityfix:cityfix@localhost:5432/cityfix?schema=public"

# --- Session cookie signing key (PLAT-REQ-002) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-session-secret-change-me-in-production-min-32-bytes"

# --- WebAuthn (PLAT-REQ-002 admin writes) ---
# Generate VAPID keys with: npx web-push generate-vapid-keys
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="CityFix"

# --- Web Push (PLAT-REQ-006; tech-audit §3) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:dev@cityfix.local"

# --- OTP SMS provider (PLAT-REQ-002; Bolt 005-003) ---
# Choose 'stub' (dev) or 'twilio' (prod). Default 'stub'.
#   stub   — logs the code to console.info; the dev persona's path
#   twilio — real Twilio SMS; the three TWILIO_* vars below are required
OTP_PROVIDER="stub"

# Twilio (only when OTP_PROVIDER=twilio). Generate at https://console.twilio.com/
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# E.164-formatted from-number, e.g. +15555550100
TWILIO_FROM_NUMBER=""

# --- Rate limiting (PLAT-REQ-008) ---
POLL_RATE_LIMIT_PER_SECOND=1